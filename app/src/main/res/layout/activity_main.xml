<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Aspect Ratio Preview Container (dynamically resized for 3:4, 9:16, 1:1, FULL) -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintBottom_toTopOf="@id/bottomControlBar"
        app:layout_constraintDimensionRatio="H,3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Camera Viewfinder -->
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

    </FrameLayout>

    <!-- Shutter Blink Flash Overlay for zero-lag physical feedback -->
    <View
        android:id="@+id/shutterBlinkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Samsung Tap-to-Focus, Brightness Slider & AE/AF Lock Container -->
    <FrameLayout
        android:id="@+id/layoutFocusExposure"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- AE/AF Lock Badge (Top of Ring) -->
        <LinearLayout
            android:id="@+id/badgeAeAfLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_lock_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.05"
                android:text="AE/AF LOCK"
                android:textColor="@color/samsung_yellow"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Focus Ring Circle -->
        <View
            android:id="@+id/focusRing"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_focus_ring" />

        <!-- Vertical Brightness Slider Bar (Right of Ring) -->
        <FrameLayout
            android:id="@+id/containerBrightnessSlider"
            android:layout_width="40dp"
            android:layout_height="120dp"
            android:layout_gravity="end|center_vertical">

            <!-- Vertical track line -->
            <View
                android:id="@+id/sliderTrack"
                android:layout_width="2dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_slider_track" />

            <!-- Draggable Sun Icon -->
            <ImageView
                android:id="@+id/imgExposureSun"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sun" />

        </FrameLayout>

    </FrameLayout>

    <!-- Pinch-to-zoom floating ratio badge -->
    <TextView
        android:id="@+id/txtZoomRatio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutZoomSelector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1.5x" />

    <!-- Countdown Timer Overlay -->
    <TextView
        android:id="@+id/txtCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="@color/white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3" />

    <!-- TOP CONTROL BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Settings Icon -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Highest Megapixel Indicator Badge -->
        <TextView
            android:id="@+id/txtMegapixel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="MAX MP"
            android:textColor="@color/samsung_yellow"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Flash Toggle Button -->
        <ImageView
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Flash Mode"
            android:padding="8dp"
            android:src="@drawable/ic_flash_off" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Timer Toggle Button -->
        <TextView
            android:id="@+id/btnTimer"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="OFF"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Aspect Ratio Button -->
        <TextView
            android:id="@+id/btnAspectRatio"
            android:layout_width="52dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:text="3:4"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Video Recording Duration Pill (at top below topBar) -->
    <LinearLayout
        android:id="@+id/layoutRecordingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_record_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:visibility="visible">

        <View
            android:id="@+id/dotRecording"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_record_dot" />

        <TextView
            android:id="@+id/txtRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.05"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Rear Camera Quick Zoom Selector: [.6] [1.0] [2.0] -->
    <LinearLayout
        android:id="@+id/layoutZoomSelector"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@id/layoutModes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 0.6x Button -->
        <TextView
            android:id="@+id/btnZoomWide"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text=".6"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 1.0x Button (Default) -->
        <TextView
            android:id="@+id/btnZoom1x"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_pill_selected"
            android:gravity="center"
            android:text="1x"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 2.0x Button -->
        <TextView
            android:id="@+id/btnZoom2x"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="2x"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Samsung Selfie Angle Selector (Single vs Group Selfie - shown in front camera) -->
    <LinearLayout
        android:id="@+id/layoutSelfieAngle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutModes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Single Person Selfie -->
        <ImageView
            android:id="@+id/btnSelfieSingle"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_pill_selected"
            android:contentDescription="Single Selfie"
            android:padding="5dp"
            android:src="@drawable/ic_person_single"
            app:tint="@color/black" />

        <!-- Group Wide Selfie -->
        <ImageView
            android:id="@+id/btnSelfieGroup"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:contentDescription="Group Selfie"
            android:padding="5dp"
            android:src="@drawable/ic_person_group"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Samsung Mode Carousel: PHOTO | VIDEO -->
    <LinearLayout
        android:id="@+id/layoutModes"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomControlBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- PHOTO Mode -->
        <LinearLayout
            android:id="@+id/modePhoto"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/txtModePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="PHOTO"
                android:textColor="@color/samsung_yellow"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorPhoto"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_pill_selected" />
        </LinearLayout>

        <!-- VIDEO Mode -->
        <LinearLayout
            android:id="@+id/modeVideo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/txtModeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="VIDEO"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorVideo"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_pill_selected"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

    <!-- BOTTOM CONTROL BAR: Gallery Thumbnail | Shutter Button | Camera Switch -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:background="#88000000"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Gallery Thumbnail Button -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnGallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_gallery_circle"
            android:contentDescription="Gallery"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_gallery_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

        <!-- Shutter Button Container -->
        <FrameLayout
            android:id="@+id/layoutShutter"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Shutter Outer Ring -->
            <View
                android:id="@+id/shutterRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_shutter_ring" />

            <!-- Shutter Inner Button -->
            <View
                android:id="@+id/btnShutter"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_photo" />

        </FrameLayout>

        <!-- Camera Switch (Flip / Selfie) Button -->
        <ImageView
            android:id="@+id/btnFlipCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_flip_circle"
            android:contentDescription="Switch to Selfie or Rear Camera"
            android:padding="12dp"
            android:src="@drawable/ic_flip_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Permission Request Overlay (shown if permissions not yet granted) -->
    <LinearLayout
        android:id="@+id/layoutPermissionCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camera &amp; Audio Access"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="To take fast photos and record smooth videos, please allow Camera and Microphone permissions."
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGrantPermissions"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/samsung_yellow"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Grant Permissions"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
